# ── Proveedor activo ──────────────────────────────────────
# Opciones: nvidia | gemini | openai | anthropic
LLM_PROVIDER=nvidia

# ── Nvidia NGC ────────────────────────────────────────────
NVIDIA_API_KEY=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
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ── Gemini ────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Anthropic ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-3-5

# ── ChromaDB ──────────────────────────────────────────────
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=uts_documents

# ── Embeddings ────────────────────────────────────────────
# Corre local, no necesita API key
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Configuración del RAG ─────────────────────────────────
# Cuántos fragmentos de documentos se recuperan por consulta
RAG_TOP_K=4
# Tamaño de cada fragmento en caracteres
RAG_CHUNK_SIZE=500
# Solapamiento entre fragmentos para no perder contexto
RAG_CHUNK_OVERLAP=50

# ── Servidor ──────────────────────────────────────────────
APP_ENV=local
APP_PORT=8000
TZ=America/Bogota